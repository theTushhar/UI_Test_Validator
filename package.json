{
  "name": "locator-verifier-workspace",
  "version": "1.0.0",
  "description": "JS Frontend Server for Locator Verifier Workspace",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "tailwindcss -i css/input.css -o css/dist/style.css --postcss --minify",
    "dev": "concurrently \"tailwindcss -i css/input.css -o css/dist/style.css --postcss --watch\" \"node server.js\"",
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.2",
    "concurrently": "^10.0.3",
    "daisyui": "^4.12.24",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "postcss": "^8.5.18",
    "postcss-import": "^16.1.1",
    "prettier": "^3.9.5",
    "tailwindcss": "^3.4.19"
  }
}
