{
  "version": 2,
  "functions": {
    "api/server.js": {
      "includeFiles": "{Data/**,mapper.json,style.css,index.html,app.js,db.js,mhtmlParserBrowser.js,mhtmlParser.js,sw.js,css/**,js/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/server.js"
    },
    {
      "source": "/serve_mhtml/(.*)",
      "destination": "/api/server.js"
    },
    {
      "source": "/(.*)",
      "destination": "/api/server.js"
    }
  ]
}
