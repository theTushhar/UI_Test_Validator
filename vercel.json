{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "functions": {
    "server.js": {
      "includeFiles": [
        "Data/**",
        "mapper.json"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server.js"
    },
    {
      "source": "/serve_mhtml/(.*)",
      "destination": "/server.js"
    },
    {
      "source": "/((?!api|serve_mhtml).*)",
      "destination": "/index.html"
    }
  ]
}
